[Unit]
Description=STM32 Networked Sensor System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sensor-monitor
Group=dialout
WorkingDirectory=/opt/stm32-networked-sensor-system
EnvironmentFile=-/etc/sensor-system.env
Environment=SENSOR_MONITOR_SOURCE=serial
Environment=SENSOR_MONITOR_LOG_DIR=/var/log/sensor-monitor
ExecStart=/opt/stm32-networked-sensor-system/.venv/bin/sensor-monitor serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/sensor-monitor

[Install]
WantedBy=multi-user.target
