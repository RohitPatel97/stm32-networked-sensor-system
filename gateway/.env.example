# Choose simulator for a no-hardware demo, serial for STM32 UART, or replay for JSONL.
SENSOR_MONITOR_SOURCE=simulator
SENSOR_MONITOR_HOST=127.0.0.1
SENSOR_MONITOR_PORT=8000

# Serial mode
SENSOR_MONITOR_SERIAL_PORT=/dev/ttyUSB0
SENSOR_MONITOR_BAUD_RATE=115200

# Replay mode
# SENSOR_MONITOR_REPLAY_FILE=examples/telemetry.jsonl
SENSOR_MONITOR_REPLAY_LOOP=true

# Health and alert policy
SENSOR_MONITOR_STALE_AFTER_SECONDS=3
SENSOR_MONITOR_OFFLINE_AFTER_SECONDS=10
SENSOR_MONITOR_WARNING_TEMPERATURE_C=60
SENSOR_MONITOR_CRITICAL_TEMPERATURE_C=80
SENSOR_MONITOR_LOW_BATTERY_V=10.8

# Operations
SENSOR_MONITOR_LOG_DIR=var/log
SENSOR_MONITOR_LOG_LEVEL=INFO
SENSOR_MONITOR_MAX_DEVICES=32
